# Optional settings for trust_gate.Settings.from_env(). Every value below is an example.
# The library reads the process environment only. It does not load .env files itself,
# so export these in your shell or let your service manager load the file.

# SQLite file for the action log and the trust ledger.
# Unset, or ":memory:", keeps nothing after the process exits.
TRUST_GATE_DB=trust_gate.db

# A spend above this amount, or of unknown amount, is T3. Use the units your tools use.
# 0 means any positive amount is T3.
TRUST_GATE_SPEND_THRESHOLD=0

# Undo window, in seconds, reported with an allowed T1 action.
TRUST_GATE_UNDO_WINDOW_SECONDS=30
